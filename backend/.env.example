# ==============================================================================
# Environment Configuration for AssistAI Backend & WhatsApp Bot
# ==============================================================================

# Port REST Server (untuk status / healthcheck)
PORT=3001

# Nama Bot
BOT_NAME="AssistAI Personal"

# 1. Google Gemini API (Dapatkan gratis di https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. Supabase PostgreSQL (Dapatkan gratis di https://supabase.com)
# URL project Supabase Anda, contoh: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Gunakan anon key atau service_role key dari Supabase Settings -> API
SUPABASE_ANON_KEY=your_supabase_anon_or_service_role_key_here

# 3. Pengaturan Opsional WhatsApp
# Jika ingin membatasi bot hanya merespons ke nomor Anda sendiri, isi nomor Anda (misal: 628123456789)
OWNER_NUMBER=

# Izinkan bot merespons di grup WhatsApp (true / false)
ALLOW_GROUPS=false

